class SchedulerType(Enum):
    FCFS = "FCFS"      # First Come First Served
    SJF = "SJF"       # Shortest Job First
    PRIORITY = "PRIORITY"
    ROUND_ROBIN = "ROUND_ROBIN"
    MLFQ = "MLFQ"     # Multi-Level Feedback Queue

class Scheduler:
    """Planificador completamente reescrito - ESTRUCTURA UNIFICADA"""
    
    def __init__(self, policy: SchedulerType = SchedulerType.FCFS, quantum: int = 3):
        self.policy = policy
        self.quantum = quantum
        
        # Colas unificadas: siempre almacenan tuplas normalizadas
        self.ready_queue = []  # Lista de procesos listos
        self.current_process: Optional[Process] = None
        self.current_quantum_used = 0
        
        # Métricas
        self.context_switches = 0
        self.waiting_times = []
        self.response_times = []
        self.turnaround_times = []
        
        # Para manejar diferentes políticas de manera unificada
        self._setup_queue()
    
    def _setup_queue(self):
        """Configura la cola según la política actual"""
        if self.policy in [SchedulerType.PRIORITY, SchedulerType.SJF, SchedulerType.MLFQ]:
            # Usar heap para estas políticas
            self.ready_queue = []
        else:
            # Usar deque para FCFS y Round Robin
            self.ready_queue = deque()
    
    def _add_to_queue(self, process: Process):
        """Añade proceso a la cola según la política - MÉTODO UNIFICADO"""
        if self.policy == SchedulerType.PRIORITY:
            # (prioridad_negativa, tiempo_llegada, contador, proceso)
            heapq.heappush(self.ready_queue, (-process.priority, process.arrival_time, process.pid, process))
        elif self.policy == SchedulerType.SJF:
            # (tiempo_restante, tiempo_llegada, contador, proceso)
            heapq.heappush(self.ready_queue, (process.remaining_time, process.arrival_time, process.pid, process))
        elif self.policy == SchedulerType.MLFQ:
            # (nivel, tiempo_llegada, contador, proceso)
            level = max(0, 3 - process.priority)  # Prioridad alta = nivel bajo
            heapq.heappush(self.ready_queue, (level, process.arrival_time, process.pid, process))
        else:  # FCFS o Round Robin
            self.ready_queue.append(process)
    
    def _get_from_queue(self) -> Optional[Process]:
        """Obtiene proceso de la cola según política - MÉTODO UNIFICADO"""
        if not self.ready_queue:
            return None
        
        self.context_switches += 1
        
        if self.policy in [SchedulerType.PRIORITY, SchedulerType.SJF, SchedulerType.MLFQ]:
            # Sacar del heap
            if self.ready_queue:
                _, _, _, process = heapq.heappop(self.ready_queue)
                return process
        else:  # FCFS o Round Robin (deque)
            if isinstance(self.ready_queue, deque):
                return self.ready_queue.popleft()
            else:
                # Fallback seguro
                return self.ready_queue.pop(0) if self.ready_queue else None
        
        return None
    
    def _get_all_ready_processes(self) -> List[Process]:
        """Obtiene todos los procesos en cola de listos - MÉTODO UNIFICADO"""
        if self.policy in [SchedulerType.PRIORITY, SchedulerType.SJF, SchedulerType.MLFQ]:
            return [item[3] for item in self.ready_queue]
        else:
            return list(self.ready_queue)
    
    def change_policy(self, new_policy: SchedulerType, quantum: Optional[int] = None):
        """Cambia la política del scheduler - SEGURO"""
        # Preservar procesos actuales
        processes = self._get_all_ready_processes()
        if self.current_process and self.current_process.state != ProcessState.TERMINATED:
            processes.append(self.current_process)
        
        # Cambiar política
        self.policy = new_policy
        if quantum is not None:
            self.quantum = quantum
        
        # Reconfigurar cola
        self._setup_queue()
        
        # Reañadir procesos
        for process in processes:
            if process.state == ProcessState.READY or process.state == ProcessState.RUNNING:
                process.state = ProcessState.READY
                self._add_to_queue(process)
        
        # Resetear proceso actual si estaba ejecutándose
        self.current_process = None
        self.current_quantum_used = 0
    
    def add_process(self, process: Process):
        """Añade proceso a la cola apropiada"""
        process.state = ProcessState.READY
        self._add_to_queue(process)
    
    def get_next_process(self) -> Optional[Process]:
        """Obtiene el siguiente proceso a ejecutar"""
        self.current_quantum_used = 0
        return self._get_from_queue()
    
    def should_preempt(self) -> bool:
        """Determina si el proceso actual debe ser preemptado"""
        if not self.current_process:
            return False
        
        # Solo preemptar si es Round Robin y el quantum se agotó
        if (self.policy == SchedulerType.ROUND_ROBIN and 
            self.current_quantum_used >= self.quantum and
            self.current_process.remaining_time > 0):
            return True
        
        return False
    
    def preempt_current(self) -> Optional[Process]:
        """Preempta el proceso actual si es necesario"""
        if not self.current_process:
            return None
        
        process = self.current_process
        process.state = ProcessState.READY
        self.add_process(process)  # Vuelve a la cola apropiada
        self.current_process = None
        self.current_quantum_used = 0
        return process
    
    def update_waiting_times(self):
        """Actualiza tiempos de espera de procesos en cola de listos"""
        for process in self._get_all_ready_processes():
            if process.state == ProcessState.READY:
                process.waiting_time += 1
    
    def get_all_ready(self) -> List[Process]:
        """Obtiene todos los procesos en cola de listos"""
        return self._get_all_ready_processes()
    
    def record_completion(self, process: Process, arrival_time: int, completion_time: int):
        """Registra métricas cuando un proceso termina"""
        turnaround = completion_time - arrival_time
        self.turnaround_times.append(turnaround)
        self.waiting_times.append(process.waiting_time)
        
        if process.response_time is not None:
            response = process.response_time - arrival_time
            self.response_times.append(response)
    
    def get_metrics(self) -> Dict[str, float]:
        """Obtiene métricas del planificador"""
        total_completed = len(self.turnaround_times)
        total_time = sum(self.turnaround_times) if self.turnaround_times else 1
        
        return {
            "context_switches": self.context_switches,
            "avg_waiting_time": sum(self.waiting_times) / max(1, len(self.waiting_times)),
            "avg_response_time": sum(self.response_times) / max(1, len(self.response_times)),
            "avg_turnaround_time": sum(self.turnaround_times) / max(1, len(self.turnaround_times)),
            "throughput": total_completed / max(1, total_time),
            "ready_processes": len(self.get_all_ready())
        }

