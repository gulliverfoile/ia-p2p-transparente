    print("• Planificador: Round Robin")
    print("• Quantum: 2 ciclos")
    print("• Duración: 25 ciclos")
    print("=" * 60)
    
    time.sleep(2)
    
    try:
        for i in range(25):
            # Crear procesos periódicamente
            if i % 4 == 0 and i < 20:
                kernel.create_process(
                    name=f"Task{i//4}",
                    io_required=(random.random() > 0.7)
                )
            
            # Ejecutar ciclo
            kernel.execute_cycle()
            
            # Limpiar pantalla
            if os.name == 'nt':
                os.system('cls')
