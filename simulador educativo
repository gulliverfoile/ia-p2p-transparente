            # Mostrar estado
            print(kernel.visualize_system_compact())
            print(f"\n📊 DEMO: Ciclo {i+1}/25")
            print("=" * 60)
            
            time.sleep(0.5)
    
    except KeyboardInterrupt:
        print("\n🛑 Demo interrumpida")
    
    # Resumen
    print("\n" + "="*40)
    print("🏁 DEMO COMPLETADA")
    print("="*40)
    
    metrics = kernel.get_system_metrics()
    print(f"⏱️  Tiempo: {metrics['time']} ciclos")
    print(f"✅ Completados: {metrics['processes_completed']}")
    print(f"📈 Throughput: {metrics['system_throughput']:.3f}")
    print(f"⏳ Espera: {metrics['avg_waiting_time']:.2f}")
    print("="*40)
    
    input("\nPresiona ENTER para continuar...")

