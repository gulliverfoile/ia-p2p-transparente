class Kernel:
    """Kernel principal que integra todos los módulos - COMPLETAMENTE CORREGIDO"""
    
    def __init__(self, memory_size: int = 1024, scheduler_policy: SchedulerType = SchedulerType.ROUND_ROBIN):
        # Módulos principales
        self.memory = MemoryManager(memory_size, "first_fit")
        self.scheduler = Scheduler(scheduler_policy, quantum=3)
        
        # Configurar listeners de memoria
        self.memory.add_free_listener(self._on_memory_freed)
        
        # Estado del sistema
        self.time = 0
        self.pid_counter = 1
        self.running = False
        
        # Procesos
        self.processes: Dict[int, Process] = {}
        self.blocked_processes: Dict[int, Process] = {}
        self.memory_blocked_processes: Set[int] = set()  # Procesos bloqueados por memoria
        
        # Sistema de eventos
        self.events = deque(maxlen=100)
        self.event_log = []
        
        # Métricas del sistema
        self.metrics = {
            "total_ticks": 0,
            "cpu_busy_ticks": 0,
            "processes_created": 0,
            "processes_completed": 0,
            "processes_blocked": 0,
            "memory_errors": 0,
            "deadlocks_detected": 0,
            "total_events": 0,
            "io_operations": 0
        }
        
        # Historial para análisis
        self.history = {
            "processes": [],
            "memory_usage": [],
            "cpu_utilization": [],
            "events_by_type": defaultdict(int)
        }
    
    def _on_memory_freed(self, pid: int, size: int):
        """Callback cuando se libera memoria - NUEVO"""
        # Intentar desbloquear procesos esperando memoria
        self._check_memory_blocked()
    
    def _check_memory_blocked(self):
        """Verifica procesos bloqueados por memoria - NUEVO Y CORREGIDO"""
        if not self.memory_blocked_processes:
            return
        
        unblocked = []
        for pid in list(self.memory_blocked_processes):
            if pid in self.processes:
                process = self.processes[pid]
                # Verificar si ahora hay memoria disponible
                if self.memory.can_allocate(process.memory)[0]:
                    addr = self.memory.allocate(process.memory, pid)
                    if addr is not None:
                        process.memory_block = addr
                        process.state = ProcessState.READY
                        process.blocked_reason = None
                        process.blocked_until = None
                        self.scheduler.add_process(process)
                        unblocked.append(pid)
                        
                        self._log_event(
                            event_type="PROCESS_UNBLOCKED",
                            description=f"Proceso desbloqueado (memoria disponible)",
                            process=process,
                            details={"reason": "memory_freed", "memory": process.memory}
                        )
        
        for pid in unblocked:
            self.memory_blocked_processes.discard(pid)
            if pid in self.blocked_processes:
                del self.blocked_processes[pid]
    
    def _log_event(self, event_type: str, description: str, 
                   process: Optional[Process] = None, **details):
        """Registra un evento en el sistema"""
        event = SystemEvent(
            timestamp=self.time,
            event_type=event_type,
            description=description,
            process_id=process.pid if process else None,
            process_name=process.name if process else None,
            details=details
        )
        
        self.events.append(event)
        self.event_log.append(event)
        
        # Actualizar métricas
        self.metrics["total_events"] += 1
        self.history["events_by_type"][event_type] += 1
        
        # Solo imprimir eventos críticos
        if event_type in ["ERROR", "WARNING", "DEADLOCK_DETECTED"]:
            level = "⚠️" if event_type == "WARNING" else "❌"
            print(f"{level} {event}")
    
    def get_recent_events(self, count: int = 10) -> List[SystemEvent]:
        """Obtiene los eventos más recientes"""
        return list(self.events)[-count:]
    
    def get_events_by_type(self, event_type: str) -> List[SystemEvent]:
        """Filtra eventos por tipo"""
        return [e for e in self.event_log if e.event_type == event_type]
    
    def create_process(self, name: str = "", burst_time: int = None, 
                      memory: int = None, priority: int = None,
                      io_required: bool = False) -> Optional[Process]:
        """Crea un nuevo proceso con parámetros opcionales - CORREGIDO"""
        # Valores por defecto
        burst_time = burst_time or random.randint(5, 15)
        memory = memory or random.randint(10, 50)
        priority = priority or random.randint(1, 5)
        
        pid = self.pid_counter
        self.pid_counter += 1
        
        process = Process(
            pid=pid,
            name=name or f"P{pid}",
            burst_time=burst_time,
            memory=memory,
            priority=priority,
            arrival_time=self.time,
            io_required=io_required,
            io_duration=random.randint(2, 4) if io_required else 0
        )
        
        self._log_event(
            event_type="PROCESS_CREATED",
            description=f"Proceso creado: {process.name}",
            process=process,
            details={
                "burst_time": burst_time,
                "memory": memory,
                "priority": priority,
                "io_required": io_required
            }
        )
        
        # Intentar asignar memoria - NUEVA LÓGICA
        if not self.memory.can_allocate(memory)[0]:
            # Bloquear por memoria (sin timeout, espera por evento)
            process.state = ProcessState.BLOCKED
            process.blocked_reason = "memory_pressure"
            self.blocked_processes[pid] = process
            self.memory_blocked_processes.add(pid)  # Registrar como bloqueado por memoria
            self.metrics["processes_blocked"] += 1
            
            self._log_event(
                event_type="PROCESS_BLOCKED",
                description=f"Proceso bloqueado por falta de memoria",
                process=process,
                details={"memory_needed": memory, "waiting_for": "memory_free"}
            )
            
            print(f"⚠️ {process.name} bloqueado: esperando {memory}B de memoria")
        else:
            addr = self.memory.allocate(memory, pid)
            if addr is None:
                # Esto no debería pasar si can_allocate dijo True
                process.state = ProcessState.TERMINATED
                self.metrics["memory_errors"] += 1
                self._log_event(
                    event_type="ERROR",
                    description=f"Error inesperado de memoria",
                    process=process
                )
                return None
            
            process.memory_block = addr
            self.scheduler.add_process(process)
            self._log_event(
                event_type="MEMORY_ALLOCATED",
                description=f"Memoria asignada: {memory}B",
                process=process,
                details={"address": addr, "size": memory}
            )
        
        self.processes[pid] = process
        self.metrics["processes_created"] += 1
        
        # Registrar en historial
        self.history["processes"].append({
            "time": self.time,
            "pid": pid,
            "action": "created",
            "state": process.state.value
        })
        
        return process
    
    def check_unblock(self):
        """Verifica si procesos bloqueados por I/O pueden desbloquearse"""
        unblocked = []
        
        for pid, process in list(self.blocked_processes.items()):
            if pid in self.memory_blocked_processes:
                # Procesos bloqueados por memoria se manejan en _check_memory_blocked
                continue
                
            if process.blocked_until and self.time >= process.blocked_until:
                # I/O completado
                process.state = ProcessState.READY
                process.blocked_reason = None
                process.blocked_until = None
                self.scheduler.add_process(process)
                unblocked.append(pid)
                
                self._log_event(
                    event_type="PROCESS_UNBLOCKED",
                    description=f"Proceso desbloqueado (I/O completado)",
                    process=process,
                    details={"reason": "io_completed"}
                )
        
        for pid in unblocked:
            del self.blocked_processes[pid]
            print(f"🔓 {self.processes[pid].name} desbloqueado (I/O)")
    
    def simulate_io_block(self, process: Process) -> bool:
        """Simula bloqueo por I/O de manera probabilística - MEJORADO"""
        if not process.io_required:
            return False
        
        # Probabilidad más realista
        base_probability = 0.15
        # La probabilidad aumenta con el uso de CPU pero tiene límite
        cpu_factor = min(0.3, process.cpu_used * 0.015)
        # La probabilidad disminuye con cada I/O ya realizado
        io_factor = max(-0.1, -process.io_count * 0.05)
        
        block_probability = base_probability + cpu_factor + io_factor
        block_probability = max(0.05, min(0.7, block_probability))  # Entre 5% y 70%
        
        if random.random() < block_probability:
            process.io_count += 1
            self.metrics["io_operations"] += 1
            
            self._log_event(
                event_type="IO_REQUEST",
                description=f"Solicitud I/O #{process.io_count}",
                process=process,
                details={
                    "probability": block_probability,
                    "duration": process.io_duration
                }
            )
            
            process.state = ProcessState.BLOCKED
            process.blocked_reason = "io_wait"
            process.blocked_until = self.time + process.io_duration
            self.blocked_processes[process.pid] = process
            self.metrics["processes_blocked"] += 1
            return True
        
        return False
    
    def execute_cycle(self):
        """Ejecuta un ciclo del kernel - ROBUSTO Y CORREGIDO"""
        self.time += 1
        self.metrics["total_ticks"] += 1
        
        # Registrar inicio de ciclo
        self._log_event(
            event_type="CYCLE_START",
            description=f"Ciclo {self.time}",
            details={
                "ready_count": len(self.scheduler.get_all_ready()),
                "blocked_count": len(self.blocked_processes)
            }
        )
        
        # Actualizar tiempos de espera
        self.scheduler.update_waiting_times()
        
        # Verificar desbloqueos (solo I/O)
        self.check_unblock()
        
        # Verificar bloqueados por memoria (manejado por eventos)
        
        # Determinar proceso a ejecutar
        current_process = None
        
        # Si hay proceso en ejecución, verificar si debe continuar
        if self.scheduler.current_process:
            # Verificar si debe preemptar
            if self.scheduler.should_preempt():
                preempted = self.scheduler.preempt_current()
                if preempted:
                    self._log_event(
                        event_type="PROCESS_PREEMPTED",
                        description=f"Proceso preemptado",
                        process=preempted,
                        details={"quantum": self.scheduler.quantum}
                    )
                    print(f"⏸️ {preempted.name} preemptado (quantum)")
            
            # Si no fue preemptado, sigue siendo el actual
            if self.scheduler.current_process:
                current_process = self.scheduler.current_process
                self.scheduler.current_quantum_used += 1
        
        # Si no hay proceso actual
        if not current_process:
            current_process = self.scheduler.get_next_process()
            if current_process:
                current_process.state = ProcessState.RUNNING
                self.scheduler.current_process = current_process
                self.scheduler.current_quantum_used = 1
        
        # Si no hay proceso para ejecutar, CPU idle
        if not current_process:
            self.history["cpu_utilization"].append(0)
            self._log_event(
                event_type="CPU_IDLE",
                description="CPU idle"
            )
            return
        
        # Proceso en ejecución
        self.metrics["cpu_busy_ticks"] += 1
        self.history["cpu_utilization"].append(1)
        
        # Registrar tiempo de respuesta (primera vez)
        if current_process.response_time is None:
            current_process.response_time = self.time
            self._log_event(
                event_type="FIRST_RESPONSE",
                description=f"Primera respuesta",
                process=current_process
            )
        
        # Ejecutar unidad de tiempo
        current_process.remaining_time -= 1
        current_process.cpu_used += 1
        
        # Verificar bloqueo por I/O
        if self.simulate_io_block(current_process):
            print(f"⏳ {current_process.name} bloqueado por I/O")
            self.scheduler.current_process = None
            self.scheduler.current_quantum_used = 0
            return
        
        # Verificar si terminó
        if current_process.remaining_time <= 0:
            current_process.state = ProcessState.TERMINATED
            current_process.completion_time = self.time
            
            # Liberar memoria
            self.memory.free(current_process.pid)
            
            # Registrar métricas
            self.scheduler.record_completion(
                current_process, 
                current_process.arrival_time,
                current_process.completion_time
            )
            
            self.metrics["processes_completed"] += 1
            self.scheduler.current_process = None
            self.scheduler.current_quantum_used = 0
            
            self._log_event(
                event_type="PROCESS_TERMINATED",
                description=f"Proceso completado",
                process=current_process,
                details={
                    "waiting_time": current_process.waiting_time,
                    "cpu_used": current_process.cpu_used,
                    "turnaround": current_process.completion_time - current_process.arrival_time
                }
            )
            
            print(f"✅ {current_process.name} completado")
        
        # Actualizar historial
        self.history["memory_usage"].append(self.memory.get_utilization())
        
        # Registrar fin de ciclo
        self._log_event(
            event_type="CYCLE_END",
            description=f"Fin ciclo {self.time}"
        )
    
    def get_system_metrics(self) -> Dict[str, Any]:
        """Obtiene métricas completas del sistema"""
        scheduler_metrics = self.scheduler.get_metrics()
        memory_stats = self.memory.get_stats()
        
        cpu_util = (self.metrics["cpu_busy_ticks"] / 
                   max(1, self.metrics["total_ticks"]))
        
        system_throughput = self.metrics["processes_completed"] / max(1, self.time)
        
        return {
            "time": self.time,
            "cpu_utilization": cpu_util,
            "processes_active": len(self.processes) - self.metrics["processes_completed"],
            "processes_completed": self.metrics["processes_completed"],
            "processes_blocked": len(self.blocked_processes),
            "memory_blocked": len(self.memory_blocked_processes),
            "memory_fragmentation": memory_stats["fragmentation"],
            "memory_utilization": memory_stats["utilization"],
            "memory_waiting": memory_stats["waiting_processes"],
            "total_events": self.metrics["total_events"],
            "io_operations": self.metrics["io_operations"],
            "event_types": dict(self.history["events_by_type"]),
            **scheduler_metrics,
            "system_throughput": system_throughput
        }
    
    def visualize_system_compact(self) -> str:
        """Visualización compacta del sistema"""
        lines = []
        
        # Header
        scheduler_name = self.scheduler.policy.value
        quantum_info = f" | Q:{self.scheduler.quantum}" if self.scheduler.policy == SchedulerType.ROUND_ROBIN else ""
        
        lines.append(f"🖥️  KERNEL QUEST 5.1 | T:{self.time:03d} | {scheduler_name}{quantum_info}")
        lines.append("=" * 70)
        
        # Procesos activos
        lines.append("\n📊 PROCESOS ACTIVOS:")
        for pid, proc in sorted(self.processes.items()):
            if proc.state != ProcessState.TERMINATED:
                status_icon = {
                    ProcessState.RUNNING: "🏃",
                    ProcessState.READY: "⏳", 
                    ProcessState.BLOCKED: "🚫",
                    ProcessState.NEW: "🆕"
                }.get(proc.state, "❓")
                
                reason = f"({proc.blocked_reason})" if proc.blocked_reason else ""
                lines.append(f"  {status_icon} {proc.name:5} | "
                           f"PID:{proc.pid:3} | "
                           f"Rem:{proc.remaining_time:3d} | "
                           f"Mem:{proc.memory:4d}B | "
                           f"Prio:{proc.priority:2d} {reason}")
        
        # Memoria
        lines.append("\n💾 MEMORIA:")
        mem_stats = self.memory.get_stats()
        lines.append(f"  Uso: {mem_stats['utilization']*100:>5.1f}% | "
                     f"Frag: {mem_stats['fragmentation']*100:>5.1f}% | "
                     f"Libre: {mem_stats['free']}/{mem_stats['total_size']}B")
        lines.append(f"  {self.memory.visualize(50)}")
        
        # Colas
        ready_count = len(self.scheduler.get_all_ready())
        blocked_count = len(self.blocked_processes)
        lines.append(f"\n📋 COLAS: ⏳Listos:{ready_count} | 🚫Bloq:{blocked_count} | "
                     f"✅Comp:{self.metrics['processes_completed']}")
        
        # Proceso actual
        if self.scheduler.current_process:
            proc = self.scheduler.current_process
            lines.append(f"\n🎯 EJECUTANDO: {proc.name} | "
                       f"T:{proc.remaining_time}s | "
                       f"CPU:{proc.cpu_used}s | "
                       f"Q:{self.scheduler.current_quantum_used}/{self.scheduler.quantum}")
        
        # Métricas clave
        metrics = self.get_system_metrics()
        lines.append(f"\n📈 MÉTRICAS: CPU:{metrics['cpu_utilization']*100:4.1f}% | "
                     f"Wait:{metrics['avg_waiting_time']:5.2f} | "
                     f"Ctx:{metrics['context_switches']:3d}")
        
        lines.append("-" * 70)
        return "\n".join(lines)
    
    def visualize_system_detailed(self) -> str:
        """Visualización detallada del sistema"""
        lines = []
        
        # Header
        scheduler_name = self.scheduler.policy.value
        lines.append(f"🖥️  KERNEL SIMULATOR | Time: {self.time:03d} | Scheduler: {scheduler_name}")
        lines.append("=" * 70)
        
        # Procesos
        lines.append("\n📊 PROCESOS:")
        for pid, proc in sorted(self.processes.items()):
            if proc.state != ProcessState.TERMINATED:
                status_icon = {
                    ProcessState.RUNNING: "▶️",
                    ProcessState.READY: "⏸️",
                    ProcessState.BLOCKED: "⏳",
                    ProcessState.NEW: "🆕"
                }.get(proc.state, "❓")
                
                lines.append(f"  {status_icon} {proc.name:10} [{proc.state.value:10}] "
                           f"CPU:{proc.cpu_used:2d} "
                           f"Rem:{proc.remaining_time:2d} "
                           f"Wait:{proc.waiting_time:3d} "
                           f"Mem:{proc.memory:4d}B")
        
        # Memoria detallada
        lines.append(f"\n💾 MEMORIA: {self.memory.visualize(50)}")
        mem_stats = self.memory.get_stats()
        lines.append(f"  Total: {mem_stats['total_size']}B | "
                     f"Usado: {mem_stats['used']}B ({mem_stats['utilization']*100:.1f}%) | "
                     f"Fragmentación: {mem_stats['fragmentation']*100:.1f}%")
        lines.append(f"  Bloques: {mem_stats['blocks']} | "
                     f"Libres: {mem_stats['free_blocks']} | "
                     f"En espera: {mem_stats['waiting_processes']}")
        
        # Colas
        ready_count = len(self.scheduler.get_all_ready())
        blocked_count = len(self.blocked_processes)
        lines.append(f"\n📋 COLAS: Ready={ready_count} | Blocked={blocked_count} | "
                   f"Completed={self.metrics['processes_completed']}")
        
        # Eventos recientes
        lines.append("\n📜 EVENTOS RECIENTES:")
        recent_events = self.get_recent_events(5)
        if recent_events:
            for event in recent_events:
                time_str = f"{event.timestamp:03d}"
                proc_str = f"{event.process_name}" if event.process_name else "Sistema"
                lines.append(f"  [{time_str}] {proc_str:10} {event.description[:40]}...")
        else:
            lines.append("  No hay eventos recientes")
        
        # Métricas detalladas
        metrics = self.get_system_metrics()
        lines.append(f"\n📈 MÉTRICAS:")
        lines.append(f"  • CPU: {metrics['cpu_utilization']*100:.1f}%")
        lines.append(f"  • Throughput: {metrics['system_throughput']:.3f} proc/ciclo")
        lines.append(f"  • Espera promedio: {metrics['avg_waiting_time']:.2f} ciclos")
        lines.append(f"  • Cambios contexto: {metrics['context_switches']}")
        
        return "\n".join(lines)
    
    def run_simulation(self, cycles: int = 50, auto_create: bool = True, compact: bool = True):
        """Ejecuta simulación automática"""
        print("\n" + "="*70)
        print("🚀 INICIANDO SIMULACIÓN DEL KERNEL")
        print(f"📋 Planificador: {self.scheduler.policy.value}")
        print("="*70)
        
        self._log_event(
            event_type="SIMULATION_START",
            description=f"Simulación: {cycles} ciclos"
        )
        
        try:
            for cycle in range(cycles):
                # Crear procesos
                if auto_create and random.random() < 0.3:
                    self.create_process(io_required=random.random() < 0.2)
                
                # Ejecutar ciclo
                self.execute_cycle()
                
                # Mostrar estado
                if compact:
                    print(self.visualize_system_compact())
                else:
                    if cycle % 10 == 0:
                        print(self.visualize_system_detailed())
                        print("-" * 70)
                
                time.sleep(0.1)
                
        except KeyboardInterrupt:
            print("\n🛑 Simulación interrumpida")
            self._log_event(
                event_type="SIMULATION_INTERRUPTED",
                description="Simulación interrumpida por usuario"
            )
        
        # Resumen final
        self.show_final_summary()
    
    def show_final_summary(self):
        """Muestra resumen final"""
        print("\n" + "="*70)
        print("📋 RESUMEN DE SIMULACIÓN")
        print("="*70)
        
        metrics = self.get_system_metrics()
        
        print(f"\n⏱️  TIEMPO TOTAL: {self.time} ciclos")
        print(f"🔄 PROCESOS: {self.metrics['processes_created']} creados, "
              f"{self.metrics['processes_completed']} completados")
        
        print(f"\n📊 EFICIENCIA:")
        print(f"  • CPU: {metrics['cpu_utilization']*100:.1f}%")
        print(f"  • Throughput: {metrics['system_throughput']:.3f} proc/ciclo")
        print(f"  • Fragmentación: {metrics['memory_fragmentation']*100:.1f}%")
        
        print(f"\n⏳ TIEMPOS PROMEDIO:")
        print(f"  • Espera: {metrics['avg_waiting_time']:.1f} ciclos")
        print(f"  • Respuesta: {metrics['avg_response_time']:.1f} ciclos")
        print(f"  • Retorno: {metrics['avg_turnaround_time']:.1f} ciclos")
        
        print(f"\n🔧 CONFIGURACIÓN:")
        print(f"  • Planificador: {self.scheduler.policy.value}")
        print(f"  • Memoria: {self.memory.total_size} bytes")
        print(f"  • Quantum: {self.scheduler.quantum} ciclos")

