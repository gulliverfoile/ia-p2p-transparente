class MemoryBlock:
    """Bloque de memoria con metadatos mejorados"""
    def __init__(self, start: int, size: int, free: bool = True, pid: Optional[int] = None):
        self.start = start
        self.size = size
        self.free = free
        self.pid = pid
        self.allocation_time: Optional[float] = None
        self.free_time: Optional[float] = None
    
    def __repr__(self):
        status = "FREE" if self.free else f"USED(P{self.pid})"
        return f"Block({self.start:#06x}-{self.start+self.size:#06x}, {status}, {self.size}B)"
    
    def allocation_duration(self) -> float:
        """Calcula duración de asignación si está asignado"""
        if self.free or not self.allocation_time:
            return 0.0
        return time.time() - self.allocation_time

class MemoryManager:
    """Gestor de memoria con estrategias y estadísticas - CORREGIDO"""
    
    def __init__(self, size: int, strategy: str = "first_fit"):
        if size <= 0:
            raise ValueError("Tamaño de memoria debe ser positivo")
        
        self.total_size = size
        self.strategy = strategy  # first_fit, best_fit, worst_fit
        self.blocks = [MemoryBlock(0, size, True)]
        self.allocations: Dict[int, List[MemoryBlock]] = defaultdict(list)
        self.fragmentation_history = []
        self.utilization_history = []
        self.waiting_processes: List[Tuple[int, int]] = []  # (pid, memory_size)
        self.free_listeners = []  # Listeners para eventos de liberación
    
    def add_free_listener(self, listener):
        """Añade un listener para eventos de liberación de memoria"""
        self.free_listeners.append(listener)
    
    def _notify_free(self, pid: int, size: int):
        """Notifica a los listeners que se liberó memoria"""
        for listener in self.free_listeners:
            listener(pid, size)
    
    def _find_first_fit(self, size: int) -> Optional[int]:
        """Primer bloque libre que tenga suficiente espacio"""
        for i, block in enumerate(self.blocks):
            if block.free and block.size >= size:
                return i
        return None
    
    def _find_best_fit(self, size: int) -> Optional[int]:
        """Bloque libre más ajustado al tamaño solicitado"""
        best_idx = None
        best_size = float('inf')
        
        for i, block in enumerate(self.blocks):
            if block.free and block.size >= size and block.size < best_size:
                best_size = block.size
                best_idx = i
        
        return best_idx
    
    def _find_worst_fit(self, size: int) -> Optional[int]:
        """Bloque libre más grande (para reducir fragmentación)"""
        worst_idx = None
        worst_size = -1
        
        for i, block in enumerate(self.blocks):
            if block.free and block.size >= size and block.size > worst_size:
                worst_size = block.size
                worst_idx = i
        
        return worst_idx
    
    def can_allocate(self, size: int) -> Tuple[bool, Optional[int]]:
        """Verifica si se puede asignar memoria y devuelve el índice del bloque"""
        if size <= 0:
            return False, None
        
        total_free = sum(b.size for b in self.blocks if b.free)
        if total_free < size:
            return False, None
        
        # Buscar según estrategia
        if self.strategy == "best_fit":
            idx = self._find_best_fit(size)
        elif self.strategy == "worst_fit":
            idx = self._find_worst_fit(size)
        else:  # first_fit por defecto
            idx = self._find_first_fit(size)
        
        return idx is not None, idx
    
    def allocate(self, size: int, pid: int) -> Optional[int]:
        """Asigna memoria a un proceso"""
        can_alloc, idx = self.can_allocate(size)
        if not can_alloc or idx is None:
            # Añadir a lista de espera
            self.waiting_processes.append((pid, size))
            return None
        
        block = self.blocks[idx]
        
        # Si el bloque es más grande, dividirlo
        if block.size > size:
            new_block = MemoryBlock(
                start=block.start + size,
                size=block.size - size,
                free=True
            )
            block.size = size
            self.blocks.insert(idx + 1, new_block)
        
        # Asignar bloque
        block.free = False
        block.pid = pid
        block.allocation_time = time.time()
        block.free_time = None
        
        # Registrar asignación
        self.allocations[pid].append(block)
        
        # Actualizar estadísticas
        self._update_stats()
        
        return block.start
    
    def free(self, pid: int) -> bool:
        """Libera toda la memoria de un proceso - MEJORADO"""
        if pid not in self.allocations:
            return False
        
        total_freed = 0
        
        for block in self.allocations[pid]:
            block.free = True
            block.pid = None
            block.free_time = time.time()
            total_freed += block.size
        
        del self.allocations[pid]
        
        # Notificar liberación de memoria
        self._notify_free(pid, total_freed)
        
        # Fusionar bloques libres adyacentes
        self._merge_free_blocks()
        
        # Intentar asignar memoria a procesos en espera
        self._process_waiting_queue()
        
        # Actualizar estadísticas
        self._update_stats()
        
        return True
    
    def _process_waiting_queue(self):
        """Procesa la cola de espera de memoria - NUEVO"""
        if not self.waiting_processes:
            return
        
        # Procesar en orden FIFO
        processed = []
        for i, (pid, size) in enumerate(self.waiting_processes):
            can_alloc, idx = self.can_allocate(size)
            if can_alloc and idx is not None:
                addr = self.allocate(size, pid)
                if addr is not None:
                    processed.append(i)
                    # Evento será manejado por el caller
        
        # Remover procesos procesados (de atrás hacia adelante)
        for i in reversed(processed):
            self.waiting_processes.pop(i)
    
    def _merge_free_blocks(self):
        """Fusiona bloques libres adyacentes eficientemente"""
        if len(self.blocks) <= 1:
            return
        
        merged = []
        current = self.blocks[0]
        
        for next_block in self.blocks[1:]:
            if current.free and next_block.free:
                # Fusionar
                current.size += next_block.size
            else:
                merged.append(current)
                current = next_block
        
        merged.append(current)
        self.blocks = merged
    
    def _update_stats(self):
        """Actualiza estadísticas de memoria"""
        # Fragmentación externa
        free_blocks = [b for b in self.blocks if b.free]
        if free_blocks:
            total_free = sum(b.size for b in free_blocks)
            largest_free = max(b.size for b in free_blocks)
            fragmentation = 1 - (largest_free / total_free) if total_free > 0 else 0
        else:
            fragmentation = 0
        
        self.fragmentation_history.append(fragmentation)
        
        # Utilización
        used = sum(b.size for b in self.blocks if not b.free)
        utilization = used / self.total_size
        self.utilization_history.append(utilization)
    
    def get_fragmentation(self) -> float:
        """Retorna fragmentación actual"""
        return self.fragmentation_history[-1] if self.fragmentation_history else 0
    
    def get_utilization(self) -> float:
        """Retorna utilización actual"""
        return self.utilization_history[-1] if self.utilization_history else 0
    
    def visualize(self, width: int = 60) -> str:
        """Representación visual ASCII de la memoria - CORREGIDO"""
        if width <= 0 or self.total_size == 0:
            return ""
        
        scale = self.total_size / width
        result = []
        block_widths = []
        total_allocated = 0
        
        # Calcular anchos con redondeo inteligente
        for block in self.blocks:
            block_width = block.size / scale
            # Usamos round para mejor precisión
            rounded_width = max(1, int(round(block_width)))
            block_widths.append((block, rounded_width))
            total_allocated += rounded_width
        
        # Ajustar si hay desviación
        if total_allocated != width and block_widths:
            diff = width - total_allocated
            if diff != 0:
                # Ajustar el último bloque
                last_block, last_width = block_widths[-1]
                new_width = max(1, last_width + diff)
                block_widths[-1] = (last_block, new_width)
        
        # Construir visualización
        result.append("[")
        for block, bw in block_widths:
            char = "░" if block.free else "█"
            result.append(char * bw)
        result.append("]")
        
        return "".join(result)
    
    def get_stats(self) -> Dict[str, Any]:
        """Obtiene estadísticas completas"""
        used = sum(b.size for b in self.blocks if not b.free)
        free_blocks = [b for b in self.blocks if b.free]
        
        return {
            "total_size": self.total_size,
            "used": used,
            "free": self.total_size - used,
            "blocks": len(self.blocks),
            "free_blocks": len(free_blocks),
            "fragmentation": self.get_fragmentation(),
            "utilization": self.get_utilization(),
            "allocations": len(self.allocations),
            "waiting_processes": len(self.waiting_processes)
        }

