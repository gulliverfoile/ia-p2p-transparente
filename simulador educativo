class ProcessState(Enum):
    NEW = "NEW"
    READY = "READY"
    RUNNING = "RUNNING"
    BLOCKED = "BLOCKED"
    TERMINATED = "TERMINATED"

@dataclass
class Process:
    """Proceso con gestión profesional de estados y recursos - CORREGIDO"""
    pid: int
    burst_time: int
    memory: int
    priority: int = 1
    name: str = ""
    dependencies: List[int] = field(default_factory=list)
    arrival_time: int = 0
    io_required: bool = False
    io_duration: int = 0
    
    # Estado interno
    state: ProcessState = ProcessState.NEW
    remaining_time: int = 0
    waiting_time: int = 0
    response_time: Optional[int] = None
    completion_time: Optional[int] = None
    memory_block: Optional[int] = None
    blocked_until: Optional[int] = None
    blocked_reason: Optional[str] = None
    cpu_used: int = 0
    io_count: int = 0  # Contador de operaciones I/O realizadas
    
    def __post_init__(self):
        self.remaining_time = self.burst_time
        if not self.name:
            self.name = f"P{self.pid}"
    
    def __lt__(self, other):
        return self.priority > other.priority  # Mayor prioridad primero
    
    def __repr__(self):
        return (f"Process({self.pid}:{self.name}, state={self.state.value}, "
                f"rem={self.remaining_time}, mem={self.memory})")
    
    def to_dict(self) -> Dict[str, Any]:
        """Serialización para guardar estado - CORREGIDO"""
        return {
            "pid": self.pid,
            "name": self.name,
            "state": self.state.value,
            "remaining_time": self.remaining_time,
            "memory": self.memory,
            "priority": self.priority,
            "waiting_time": self.waiting_time,  # CORREGIDO: era process.waiting_time
            "cpu_used": self.cpu_used,
            "io_count": self.io_count
        }

