        // Función principal de análisis
        function performAnalysis(text) {
            const sentences = text.split(/[.!?]+/).filter(s => s.trim().length > 0);
            const words = text.trim().split(/\s+/);
            
            const analysis = {
                general: {
                    totalWords: words.length,
                    totalSentences: sentences.length,
                    totalCharacters: text.length,
                    readingTime: Math.ceil(words.length / 200),
                    factualSentences: 0,
                    opinionSentences: 0,
                    emotionalSentences: 0,
                    textType: "indeterminado"
                },
                issues: {
                    fallacies: [],
                    propaganda: [],
                    biases: [],
                    emotionalLanguage: []
                },
                scores: {
                    objectivity: 75,
                    manipulationRisk: 30,
                    credibility: 65
                }
            };
            
            // Patrones para clasificar oraciones
            const structuralPatterns = {
                factual: /(según|datos|porcentaje|estudio|encuesta|informe|estadística|científicos|investigación|cifras|publicado en|demuestra que)/gi,
                opinion: /(creo|pienso|opino|considero|me parece|en mi opinión|desde mi punto de vista|en mi experiencia)/gi,
                emotional: /(amenaza|desastre|enemigos|traición|crisis|vergüenza|peligro|catástrofe|desesperación|horroroso|terrible|inaceptable)/gi
            };
            
            // Patrones estructurales que aumentan credibilidad
            const structureBoost = /(%|porcentaje|encuesta|según datos|informe anual|comparado con|estudio de|investigadores|publicado por|fuente:|referencia:)/gi;
            
            // Patrones para detectar problemas (versión expandida)
            const patterns = {
                fallacies: [
                    {pattern: /(o [^,]+ o [^,.]+|no hay término medio|blanco o negro)/gi, name: "Falso dilema", severity: "high"},
                    {pattern: /(si [^,]+ entonces|terminaremos en|llevará a|inevitablemente)/gi, name: "Pendiente resbaladiza", severity: "medium"},
                    {pattern: /(todos los|siempre|nunca|nadie|absolutamente todos|cada uno)/gi, name: "Generalización apresurada", severity: "low"},
                    {pattern: /(porque sí|es así y punto|no hace falta explicarlo)/gi, name: "Argumento circular", severity: "high"},
                    {pattern: /(eres un|estás loco|no sabes nada|ignorante)/gi, name: "Ad hominem", severity: "high"}
                ],
                propaganda: [
                    {pattern: /(nosotros|ellos|enemigos|adversarios|contrarios|los otros)/gi, name: "Nosotros vs Ellos", severity: "high"},
                    {pattern: /(peligro|crisis|desastre|amenaza|catástrofe|alerta roja)/gi, name: "Apelación al miedo", severity: "high"},
                    {pattern: /(héroe|salvador|libertador|mesías|iluminado)/gi, name: "Culto a la personalidad", severity: "medium"}
                ],
                biases: [
                    {pattern: /(obviamente|sin duda|es evidente|claramente|indudablemente)/gi, name: "Sesgo de confirmación", severity: "medium"},
                    {pattern: /(los expertos dicen|todo el mundo sabe|es ampliamente conocido)/gi, name: "Apelación a la autoridad", severity: "low"},
                    {pattern: /(como es natural|lógicamente|como todos sabemos)/gi, name: "Normalización de asunciones", severity: "medium"}
                ],
                emotionalLanguage: [
                    {pattern: /(desastroso|terrible|horrible|espantoso|inaceptable|vergonzoso|escandaloso)/gi, name: "Lenguaje emotivo intenso", severity: "medium"},
                    {pattern: /(maravilloso|increíble|fantástico|perfecto|ideal)/gi, name: "Lenguaje excesivamente positivo", severity: "low"}
                ]
            };
            
            let structureSignals = 0;
            
            // Analizar cada oración
            sentences.forEach((s, i) => {
                const sentence = s.trim();
                if (sentence.length === 0) return;
                
                if (structuralPatterns.factual.test(sentence)) analysis.general.factualSentences++;
                if (structuralPatterns.opinion.test(sentence)) analysis.general.opinionSentences++;
                if (structuralPatterns.emotional.test(sentence)) analysis.general.emotionalSentences++;
                if (structureBoost.test(sentence)) structureSignals++;
                
                // Detectar falacias
                patterns.fallacies.forEach(f => {
                    if (f.pattern.test(sentence)) {
                        analysis.issues.fallacies.push({
                            type: f.name,
                            sentence: sentence,
                            severity: f.severity,
                            position: i
                        });
                    }
                });
                
                // Detectar propaganda
                patterns.propaganda.forEach(p => {
                    if (p.pattern.test(sentence)) {
                        analysis.issues.propaganda.push({
                            type: p.name,
                            sentence: sentence,
                            severity: p.severity,
                            position: i
                        });
                    }
                });
                
                // Detectar sesgos
                patterns.biases.forEach(b => {
                    if (b.pattern.test(sentence)) {
                        analysis.issues.biases.push({
                            type: b.name,
                            sentence: sentence,
                            severity: b.severity,
                            position: i
                        });
                    }
                });
                
                // Detectar lenguaje emocional
                patterns.emotionalLanguage.forEach(e => {
                    if (e.pattern.test(sentence)) {
                        analysis.issues.emotionalLanguage.push({
                            type: e.name,
                            sentence: sentence,
                            severity: e.severity,
                            position: i
                        });
                    }
                });
            });
            
            // Determinar tipo de texto
            if (analysis.general.factualSentences > analysis.general.opinionSentences && 
                analysis.general.factualSentences > analysis.general.emotionalSentences) {
                analysis.general.textType = "Informativo";
            } else if (analysis.general.emotionalSentences > analysis.general.factualSentences && 
                       analysis.general.emotionalSentences > analysis.general.opinionSentences) {
                analysis.general.textType = "Emocional/Agitativo";
            } else if (analysis.general.opinionSentences > analysis.general.factualSentences) {
                analysis.general.textType = "Opinativo/Persuasivo";
            } else {
                analysis.general.textType = "Mixto";
            }
            
            // Calcular problemas totales
            analysis.general.totalProblems = 
                analysis.issues.fallacies.length + 
                analysis.issues.propaganda.length + 
                analysis.issues.biases.length +
                analysis.issues.emotionalLanguage.length;
            
            // Calcular riesgo de manipulación
            let risk = analysis.general.totalProblems * 8 + 
                      analysis.general.emotionalSentences * 3 - 
                      structureSignals * 4;
            
            // Ajustar basado en proporción hechos/opiniones
            const factOpinionRatio = analysis.general.factualSentences > 0 ? 
                analysis.general.opinionSentences / analysis.general.factualSentences : 5;
            
            if (factOpinionRatio > 2) risk += 15;
            if (factOpinionRatio > 4) risk += 10;
            
            // Limitar entre 5 y 95
            risk = Math.max(5, Math.min(95, risk));
            
            analysis.scores.manipulationRisk = Math.round(risk);
            analysis.scores.objectivity = Math.round(100 - risk);
            analysis.scores.credibility = Math.max(20, Math.min(95, 
                60 + (structureSignals * 5) - (analysis.general.totalProblems * 3)
            ));
            
            // Calcular ratio hechos/opiniones
            analysis.general.factToOpinionRatio = analysis.general.factualSentences > 0 ? 
                (analysis.general.factualSentences / (analysis.general.opinionSentences || 1)).toFixed(1) : "0";
            
            return analysis;
        }
        
        // Mostrar resumen ejecutivo
        function displayExecutiveSummary(analysis) {
            // Determinar color del card de riesgo
            let riskColorClass = 'red';
            if (analysis.scores.manipulationRisk <= 40) {
                riskColorClass = 'green';
            } else if (analysis.scores.manipulationRisk <= 70) {
                riskColorClass = 'orange';
            }
            
            // Determinar color del card de problemas
            let problemColorClass = 'green';
            if (analysis.general.totalProblems > 8) {
                problemColorClass = 'red';
            } else if (analysis.general.totalProblems > 4) {
                problemColorClass = 'orange';
            }
            
            executiveSummary.innerHTML = `
                <div class="summary-card blue">
                    <div class="summary-icon">📊</div>
                    <div class="summary-title">TIPO DE TEXTO</div>
                    <div class="summary-value">${analysis.general.textType}</div>
                    <div class="summary-subtext">${analysis.general.totalSentences} oraciones</div>
                </div>
                
                <div class="summary-card ${problemColorClass}">
                    <div class="summary-icon">⚠️</div>
                    <div class="summary-title">PROBLEMAS</div>
                    <div class="summary-value">${analysis.general.totalProblems}</div>
                    <div class="summary-subtext">Detectados</div>
                </div>
                
                <div class="summary-card purple">
                    <div class="summary-icon">⚖️</div>
                    <div class="summary-title">HECHOS:OPINIONES</div>
                    <div class="summary-value">${analysis.general.factualSentences}:${analysis.general.opinionSentences}</div>
                    <div class="summary-subtext">Ratio ${analysis.general.factToOpinionRatio}:1</div>
                </div>
                
                <div class="summary-card ${riskColorClass}">
                    <div class="summary-icon">🧠</div>
                    <div class="summary-title">RIESGO NARRATIVO</div>
                    <div class="summary-value">${analysis.scores.manipulationRisk}%</div>
                    <div class="summary-subtext">Evaluación estructural</div>
                </div>
            `;
        }
        
        // Mostrar puntuaciones - CORREGIDO (sin carga infinita)
        function displayScores(analysis) {
            objectivityScore.textContent = `${analysis.scores.objectivity}%`;
            riskScore.textContent = `${analysis.scores.manipulationRisk}%`;
            credibilityScore.textContent = `${analysis.scores.credibility}%`;
            
            objectivityBar.style.width = `${analysis.scores.objectivity}%`;
            riskBar.style.width = `${analysis.scores.manipulationRisk}%`;
            credibilityBar.style.width = `${analysis.scores.credibility}%`;
            
            // Cambiar color de la barra de riesgo según el nivel
            if (analysis.scores.manipulationRisk > 70) {
                riskBar.style.background = '#e74c3c';
            } else if (analysis.scores.manipulationRisk > 40) {
                riskBar.style.background = '#f39c12';
            } else {
                riskBar.style.background = '#2ecc71';
            }
        }
        
        // Mostrar explicación de un problema
        function displayExplanation(problemType) {
            const explanation = problemExplanations[problemType];
            
            if (explanation) {
                explanationsPanel.innerHTML = `
                    <h3 class="explanation-title">${explanation.title}</h3>
                    <div class="explanation-content">
                        <p><strong>Descripción:</strong> ${explanation.description}</p>
                        <div class="explanation-example">
                            <h5>Ejemplo:</h5>
                            <p>${explanation.example}</p>
                        </div>
                    </div>
                `;
            } else {
                explanationsPanel.innerHTML = `
                    <div class="explanation-placeholder">
                        <div class="icon">❓</div>
                        <h3>${problemType}</h3>
                        <p>No hay una explicación detallada disponible para este problema específico.</p>
                    </div>
                `;
            }
        }
        
        // Mostrar problemas en las pestañas
        function displayProblems(analysis) {
            // Actualizar badges
            fallaciesBadge.textContent = analysis.issues.fallacies.length;
            propagandaBadge.textContent = analysis.issues.propaganda.length;
            biasesBadge.textContent = analysis.issues.biases.length;
            emotionalBadge.textContent = analysis.issues.emotionalLanguage.length;
            
            // Función para crear HTML de un problema
            function createIssueHTML(issue) {
                const severityText = issue.severity === 'high' ? 'Alto' : issue.severity === 'medium' ? 'Medio' : 'Bajo';
                return `
                    <div class="issue-item ${issue.severity}" data-type="${issue.type}">
                        <div class="issue-type">
                            ${issue.type}
                            <span class="severity-badge ${issue.severity}">${severityText}</span>
                        </div>
                        <div class="issue-sentence">"${issue.sentence.length > 120 ? issue.sentence.substring(0, 120) + '...' : issue.sentence}"</div>
                    </div>
                `;
            }
            
            // Mostrar todos los problemas en la pestaña "all"
            const allIssues = [
                ...analysis.issues.fallacies,
                ...analysis.issues.propaganda,
                ...analysis.issues.biases,
                ...analysis.issues.emotionalLanguage
            ];
            
            // Ordenar por severidad (high primero)
            allIssues.sort((a, b) => {
                const severityOrder = { high: 3, medium: 2, low: 1 };
                return severityOrder[b.severity] - severityOrder[a.severity];
            });
            
            if (allIssues.length > 0) {
                document.getElementById('tab-all').innerHTML = `
                    <div class="issues-grid">
                        <div class="issue-category">
                            <h4>Todos los problemas <span class="count">${allIssues.length}</span></h4>
                            ${allIssues.map(createIssueHTML).join('')}
                        </div>
                    </div>
                `;
            } else {
                document.getElementById('tab-all').innerHTML = '<div class="empty-state">No se han detectado problemas en el texto</div>';
            }
            
            // Mostrar falacias
            if (analysis.issues.fallacies.length > 0) {
                document.getElementById('tab-fallacies').innerHTML = `
                    <div class="issues-grid">
                        <div class="issue-category">
                            <h4>Falacias Lógicas <span class="count">${analysis.issues.fallacies.length}</span></h4>
                            ${analysis.issues.fallacies.map(createIssueHTML).join('')}
                        </div>
                    </div>
                `;
            } else {
                document.getElementById('tab-fallacies').innerHTML = '<div class="empty-state">No se han detectado falacias lógicas</div>';
            }
            
            // Mostrar propaganda
            if (analysis.issues.propaganda.length > 0) {
                document.getElementById('tab-propaganda').innerHTML = `
                    <div class="issues-grid">
                        <div class="issue-category">
                            <h4>Técnicas de Propaganda <span class="count">${analysis.issues.propaganda.length}</span></h4>
                            ${analysis.issues.propaganda.map(createIssueHTML).join('')}
                        </div>
                    </div>
                `;
            } else {
                document.getElementById('tab-propaganda').innerHTML = '<div class="empty-state">No se han detectado técnicas de propaganda</div>';
            }
            
            // Mostrar sesgos
            if (analysis.issues.biases.length > 0) {
                document.getElementById('tab-biases').innerHTML = `
                    <div class="issues-grid">
                        <div class="issue-category">
                            <h4>Sesgos Cognitivos <span class="count">${analysis.issues.biases.length}</span></h4>
                            ${analysis.issues.biases.map(createIssueHTML).join('')}
                        </div>
                    </div>
                `;
            } else {
                document.getElementById('tab-biases').innerHTML = '<div class="empty-state">No se han detectado sesgos cognitivos</div>';
            }
            
            // Mostrar lenguaje emocional
            if (analysis.issues.emotionalLanguage.length > 0) {
                document.getElementById('tab-emotional').innerHTML = `
                    <div class="issues-grid">
                        <div class="issue-category">
                            <h4>Lenguaje Emocional <span class="count">${analysis.issues.emotionalLanguage.length}</span></h4>
                            ${analysis.issues.emotionalLanguage.map(createIssueHTML).join('')}
                        </div>
                    </div>
                `;
            } else {
                document.getElementById('tab-emotional').innerHTML = '<div class="empty-state">No se ha detectado lenguaje emocional excesivo</div>';
            }
            
            // Agregar event listeners a los problemas
            document.querySelectorAll('.issue-item').forEach(item => {
                item.addEventListener('click', function() {
                    // Remover clase active de todos los items
                    document.querySelectorAll('.issue-item').forEach(i => i.classList.remove('active'));
                    // Añadir clase active al item clickeado
                    this.classList.add('active');
                    
                    const problemType = this.getAttribute('data-type');
                    currentSelectedIssue = problemType;
                    displayExplanation(problemType);
                });
            });
        }
        
        // Función para cambiar pestañas
        function switchTab(tabName) {
            // Ocultar todos los contenidos
            tabContents.forEach(tab => {
                tab.classList.remove('active');
            });
            
            // Mostrar el contenido seleccionado
            document.getElementById(`tab-${tabName}`).classList.add('active');
            
            // Actualizar botones activos
            tabButtons.forEach(button => {
                button.classList.remove('active');
                if (button.getAttribute('data-tab') === tabName) {
                    button.classList.add('active');
                }
            });
            
            // Mostrar placeholder en explicaciones si no hay problema seleccionado
            if (!currentSelectedIssue) {
                explanationsPanel.innerHTML = `
                    <div class="explanation-placeholder">
                        <div class="icon">💡</div>
                        <h3>Selecciona un problema</h3>
                        <p>Haz clic en cualquier problema de la lista para ver su explicación detallada.</p>
                    </div>
                `;
            }
        }
        
        // Función principal para ejecutar el análisis
        function runAnalysis() {
            const text = textInput.value.trim();
            
            if (text.length < 20) {
                alert("Por favor, introduce un texto más largo (mínimo 20 caracteres).");
                return;
            }
            
            // Mostrar estado de carga
            executiveSummary.innerHTML = `
                <div class="summary-card blue" style="grid-column: 1 / 3;">
                    <div class="summary-icon">
                        <div class="loading-spinner"></div>
                    </div>
                    <div class="summary-title">ANALIZANDO TEXTO</div>
                    <div class="summary-value">Procesando...</div>
                    <div class="summary-subtext">Esto tomará solo unos segundos</div>
                </div>
            `;
            
            // Mostrar loading en puntuaciones (sin reemplazar toda la estructura)
            objectivityScore.textContent = "...";
            riskScore.textContent = "...";
            credibilityScore.textContent = "...";
            objectivityBar.style.width = "0%";
            riskBar.style.width = "0%";
            credibilityBar.style.width = "0%";
            
            // Mostrar loading en pestañas
            tabContents.forEach(tab => {
                tab.innerHTML = '<div class="loading"><div class="loading-spinner"></div><p>Analizando problemas...</p></div>';
            });
            
            // Mostrar loading en explicaciones
            explanationsPanel.innerHTML = `
                <div class="explanation-placeholder">
                    <div class="loading-spinner"></div>
                    <p>Analizando texto...</p>
                </div>
            `;
            
            // Cambiar texto del botón
            analyzeBtn.textContent = "Analizando...";
            analyzeBtn.disabled = true;
            
            // Ejecutar análisis después de un breve retraso para mejor UX
            setTimeout(() => {
                currentAnalysis = performAnalysis(text);
                
                // Mostrar resultados
                displayExecutiveSummary(currentAnalysis);
                displayScores(currentAnalysis);
                displayProblems(currentAnalysis);
                
                // Restaurar botón
                analyzeBtn.textContent = "Analizar Texto";
                analyzeBtn.disabled = false;
                
                // Efecto visual
                analyzeBtn.style.background = "#2ecc71";
                setTimeout(() => {
                    analyzeBtn.style.background = "#4a6cf7";
                }, 1000);
                
            }, 800);
        }
        
        // Función para limpiar el texto
        function clearText() {
            textInput.value = "";
            textInput.focus();
            
            // Restablecer UI a estado inicial
            executiveSummary.innerHTML = `
                <div class="summary-card blue">
                    <div class="summary-icon">📊</div>
                    <div class="summary-title">TIPO DE TEXTO</div>
                    <div class="summary-value">-</div>
                    <div class="summary-subtext">Esperando análisis</div>
                </div>
                
                <div class="summary-card green">
                    <div class="summary-icon">⚠️</div>
                    <div class="summary-title">PROBLEMAS</div>
                    <div class="summary-value">0</div>
                    <div class="summary-subtext">Detectados</div>
                </div>
                
                <div class="summary-card purple">
                    <div class="summary-icon">⚖️</div>
                    <div class="summary-title">HECHOS:OPINIONES</div>
                    <div class="summary-value">-:-</div>
                    <div class="summary-subtext">Ratio -:-</div>
                </div>
                
                <div class="summary-card red">
                    <div class="summary-icon">🧠</div>
                    <div class="summary-title">RIESGO NARRATIVO</div>
                    <div class="summary-value">0%</div>
                    <div class="summary-subtext">Evaluación estructural</div>
                </div>
            `;
            
            // Restablecer puntuaciones
            objectivityScore.textContent = "0%";
            riskScore.textContent = "0%";
            credibilityScore.textContent = "0%";
            objectivityBar.style.width = "0%";
            riskBar.style.width = "0%";
            credibilityBar.style.width = "0%";
            
            // Restablecer badges
            fallaciesBadge.textContent = "0";
            propagandaBadge.textContent = "0";
            biasesBadge.textContent = "0";
            emotionalBadge.textContent = "0";
            
            // Restablecer pestañas
            tabContents.forEach(tab => {
                if (tab.id === 'tab-all') {
                    tab.innerHTML = '<div class="empty-state">Ejecuta el análisis para ver los problemas detectados</div>';
                } else {
                    const tabId = tab.id.replace('tab-', '');
                    const emptyText = {
                        fallacies: 'No se han detectado falacias lógicas',
                        propaganda: 'No se han detectado técnicas de propaganda',
                        biases: 'No se han detectado sesgos cognitivos',
                        emotional: 'No se ha detectado lenguaje emocional excesivo'
                    }[tabId] || 'No hay problemas detectados';
                    tab.innerHTML = `<div class="empty-state">${emptyText}</div>`;
                }
            });
            
            // Restablecer explicaciones
            explanationsPanel.innerHTML = `
                <div class="explanation-placeholder">
                    <div class="icon">💡</div>
                    <h3>Selecciona un problema</h3>
                    <p>Haz clic en cualquier problema de la lista para ver su explicación detallada.</p>
                </div>
            `;
            
            // Asegurarse de que la pestaña "all" esté activa
            switchTab('all');
            
            currentAnalysis = null;
            currentSelectedIssue = null;
        }
        
        // Event Listeners
        analyzeBtn.addEventListener('click', runAnalysis);
        clearBtn.addEventListener('click', clearText);
        
        // Permitir usar Ctrl+Enter para ejecutar el análisis
        textInput.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 'Enter') {
                runAnalysis();
            }
        });
        
        // Event listeners para pestañas
        problemsTabs.addEventListener('click', (e) => {
            if (e.target.classList.contains('tab')) {
                const tabName = e.target.getAttribute('data-tab');
                switchTab(tabName);
            }
        });
        
        // Ejecutar análisis inicial con texto de ejemplo
        setTimeout(() => {
            runAnalysis();
        }, 500);
    </script>
</body>
</html>
