class ProtocolType(Enum):
    """Tipos de protocolos disponibles"""
    HTTP = "HTTP"
    TCP = "TCP"
    UDP = "UDP"
    ONION = "Onion Routing"
    QUIC = "QUIC (experimental)"
    BITCOIN = "Bitcoin P2P (simplificado)"

class PacketType(Enum):
    """Tipos de paquetes"""
    DATA = "DATA"
    ACK = "ACK"
    SYN = "SYN"
    SYN_ACK = "SYN-ACK"
    FIN = "FIN"
    RST = "RST"
    GET = "GET"
    POST = "POST"
    RESPONSE = "RESPONSE"
    ONION_LAYER = "ONION_LAYER"
    ROUTING = "ROUTING"

class SecurityLevel(Enum):
    """Niveles de seguridad"""
    NONE = "Sin cifrado"
    BASIC = "Cifrado básico"
    STRONG = "Cifrado fuerte"
    ONION = "Cifrado multicapa (onion)"

class NetworkEventType(Enum):
    """Eventos de red"""
    PACKET_SENT = "PACKET_SENT"
    PACKET_RECEIVED = "PACKET_RECEIVED"
    CONNECTION_ESTABLISHED = "CONNECTION_ESTABLISHED"
    CONNECTION_CLOSED = "CONNECTION_CLOSED"
    TIMEOUT = "TIMEOUT"
    ERROR = "ERROR"
    ROUTING_CHANGE = "ROUTING_CHANGE"
    SECURITY_BREACH = "SECURITY_BREACH"
    LATENCY_CHANGE = "LATENCY_CHANGE"

@dataclass
class NetworkEvent:
    """Evento en la red"""
    timestamp: float
    event_type: NetworkEventType
    source: str
    destination: str
    protocol: ProtocolType
    details: Dict[str, Any] = field(default_factory=dict)
    
    def __repr__(self):
        return f"[{self.timestamp:.3f}] {self.event_type.value}: {self.source} -> {self.destination}"

@dataclass
class Packet:
    """Paquete de red"""
    packet_id: int
    source: str
    destination: str
    packet_type: PacketType
    payload: Any
    protocol: ProtocolType
    sequence_num: int = 0
    ack_num: int = 0
    ttl: int = 64  # Time To Live
    checksum: Optional[str] = None
    encrypted: bool = False
    layers: List[Dict] = field(default_factory=list)  # Para onion routing
    
    def calculate_checksum(self) -> str:
        """Calcula checksum simple del paquete"""
        data = f"{self.source}{self.destination}{self.packet_type}{self.payload}"
        return hashlib.md5(data.encode()).hexdigest()[:8]
    
    def to_dict(self) -> Dict[str, Any]:
        """Serializa el paquete"""
        return {
            "id": self.packet_id,
            "source": self.source,
            "destination": self.destination,
            "type": self.packet_type.value,
            "protocol": self.protocol.value,
            "ttl": self.ttl,
            "encrypted": self.encrypted,
            "layers": len(self.layers) if self.layers else 0
        }

@dataclass
class Node:
    """Nodo en la red"""
    node_id: str
    node_type: str  # "client", "server", "router", "relay"
    ip_address: str
    bandwidth: int  # Mbps
    latency: float  # ms
    reliability: float  # 0.0 a 1.0
    is_malicious: bool = False
    is_compromised: bool = False
    connections: List[str] = field(default_factory=list)
    packets_sent: int = 0
    packets_received: int = 0
    packets_dropped: int = 0
    
    def __repr__(self):
        status = "⚠️" if self.is_malicious else "✅"
        return f"{status} Node({self.node_id}:{self.node_type}, BW:{self.bandwidth}Mbps, Lat:{self.latency}ms)"

