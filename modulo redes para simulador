class HTTPProtocol(Protocol):
    """Protocolo HTTP simplificado"""
    
    def __init__(self, security_level: SecurityLevel):
        super().__init__(ProtocolType.HTTP, security_level)
        self.sessions = {}
        self.http_methods = ["GET", "POST", "PUT", "DELETE", "HEAD"]
    
    def send(self, packet: Packet, network: 'Network') -> bool:
        """Envía una petición HTTP"""
        if packet.packet_type == PacketType.GET:
            # Simular petición GET
            packet.payload = f"GET {packet.payload} HTTP/1.1\r\nHost: {packet.destination}\r\n\r\n"
        elif packet.packet_type == PacketType.POST:
            # Simular petición POST
            packet.payload = f"POST {packet.payload} HTTP/1.1\r\nHost: {packet.destination}\r\nContent-Length: {len(str(packet.payload))}\r\n\r\n{packet.payload}"
        
        return super().send(packet, network)
    
    def receive(self, packet: Packet, network: 'Network') -> bool:
        """Procesa una respuesta HTTP"""
        if "HTTP/1.1" in str(packet.payload):
            status_code = random.choice([200, 404, 500, 301])
            response = f"HTTP/1.1 {status_code} OK\r\nServer: NetworkQuest\r\n\r\nResponse to {packet.source}"
            packet.payload = response
        
        return super().receive(packet, network)
    
    def get_protocol_info(self) -> Dict[str, Any]:
        info = super().get_protocol_info()
        info.update({
