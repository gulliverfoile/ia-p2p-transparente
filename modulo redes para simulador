class TCPProtocol(Protocol):
    """Protocolo TCP simplificado (con 3-way handshake)"""
    
    def __init__(self, security_level: SecurityLevel):
        super().__init__(ProtocolType.TCP, security_level)
        self.connections = {}  # (source, dest) -> estado
        self.window_size = 4  # Ventana deslizante simplificada
        self.timeout = 2.0  # segundos
    
    def send(self, packet: Packet, network: 'Network') -> bool:
        """Envía un paquete TCP"""
        connection_key = (packet.source, packet.destination)
        
        # Establecer conexión si no existe
        if connection_key not in self.connections:
            if packet.packet_type != PacketType.SYN:
                # Necesitamos SYN primero
                syn_packet = self.create_packet(packet.source, packet.destination, 
                                               PacketType.SYN, "SYN")
                self.connections[connection_key] = "SYN_SENT"
                return super().send(syn_packet, network)
        
        # Procesar según estado
        state = self.connections.get(connection_key, "CLOSED")
        
        if state == "SYN_SENT" and packet.packet_type == PacketType.SYN_ACK:
            self.connections[connection_key] = "ESTABLISHED"
            ack_packet = self.create_packet(packet.source, packet.destination, 
                                           PacketType.ACK, "ACK")
            super().send(ack_packet, network)
        
        elif state == "ESTABLISHED":
            # Envío de datos con ventana deslizante
            packet.sequence_num = self.packet_counter
            # Simular ACK después de un tiempo
            if random.random() > 0.1:  # 90% de éxito
                network.schedule_event(
                    time.time() + 0.1,
                    lambda: self._receive_ack(packet, network)
                )
            else:
                self.metrics["retransmissions"] += 1
        
        return super().send(packet, network)
    
    def _receive_ack(self, packet: Packet, network: 'Network'):
        """Simula recepción de ACK"""
        ack_packet = self.create_packet(packet.destination, packet.source, 
                                       PacketType.ACK, f"ACK for {packet.sequence_num}")
        ack_packet.ack_num = packet.sequence_num + 1
        self.receive(ack_packet, network)
    
    def get_protocol_info(self) -> Dict[str, Any]:
        info = super().get_protocol_info()
        info.update({
            "description": "Protocolo de Control de Transmisión (TCP). Protocolo orientado a conexión de la capa de transporte que garantiza entrega confiable y ordenada.",
            "advantages": [
                "Garantiza entrega confiable de datos",
                "Mantiene orden de paquetes",
                "Control de congestión integrado",
                "Control de flujo mediante ventana deslizante"
            ],
            "disadvantages": [
                "Overhead mayor que UDP",
                "Establecimiento de conexión lento (3-way handshake)",
                "No ideal para transmisiones en tiempo real",
                "Head-of-line blocking"
            ],
            "use_cases": [
                "Transferencia de archivos (FTP)",
                "Correo electrónico (SMTP)",
                "Navegación web (HTTP/HTTPS)",
                "Conexiones SSH"
            ],
            "features": [
                "3-way handshake",
                "Ventana deslizante",
                "Control de congestión",
                "Retransmisión con timeout"
            ]
        })
        return info

