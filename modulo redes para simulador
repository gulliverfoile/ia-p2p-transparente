            "successful_deliveries": 0,
            "failed_deliveries": 0,
            "average_latency": 0.0,
            "total_bandwidth_used": 0,
            "security_breaches": 0
        }
        
        # Inicializar con protocolos por defecto
        self._initialize_default_protocols()
    
    def _initialize_default_protocols(self):
        """Inicializa los protocolos disponibles"""
        for protocol_type in ProtocolType:
            protocol = ProtocolFactory.create_protocol(protocol_type)
            self.protocols[protocol_type] = protocol
    
    def add_node(self, node_id: str, node_type: str, **kwargs):
        """Añade un nodo a la red"""
        node = Node(
            node_id=node_id,
            node_type=node_type,
            ip_address=f"192.168.{random.randint(1,255)}.{random.randint(1,255)}",
            bandwidth=kwargs.get('bandwidth', 100),
            latency=kwargs.get('latency', 10.0),
            reliability=kwargs.get('reliability', 0.95),
            is_malicious=kwargs.get('is_malicious', False)
        )
        self.nodes[node_id] = node
        return node
    
    def connect_nodes(self, node1_id: str, node2_id: str, 
                     latency: float = None, bandwidth: int = None):
        """Conecta dos nodos"""
        if node1_id not in self.nodes or node2_id not in self.nodes:
            raise ValueError("Nodo no encontrado")
        
        node1 = self.nodes[node1_id]
        node2 = self.nodes[node2_id]
        
        if node2_id not in node1.connections:
            node1.connections.append(node2_id)
        if node1_id not in node2.connections:
            node2.connections.append(node1_id)
        
        # Establecer métricas de conexión
        connection_latency = latency or max(node1.latency, node2.latency) * 1.5
        connection_bandwidth = bandwidth or min(node1.bandwidth, node2.bandwidth)
        
        self.routes[node1_id][node2_id] = {
            "latency": connection_latency,
            "bandwidth": connection_bandwidth,
            "reliability": min(node1.reliability, node2.reliability)
        }
        self.routes[node2_id][node1_id] = self.routes[node1_id][node2_id]
        
        self._log_event(
            NetworkEventType.CONNECTION_ESTABLISHED,
            node1_id,
            node2_id,
            {"latency": connection_latency, "bandwidth": connection_bandwidth}
        )
    
    def send_message(self, source: str, destination: str, 
                    message: str, protocol_type: ProtocolType) -> bool:
        """Envía un mensaje usando el protocolo especificado"""
        if source not in self.nodes or destination not in self.nodes:
            raise ValueError("Nodo no encontrado")
        
        protocol = self.protocols.get(protocol_type)
        if not protocol:
            raise ValueError(f"Protocolo no disponible: {protocol_type}")
        
        # Crear paquete
        packet = protocol.create_packet(source, destination, PacketType.DATA, message)
        
        # Buscar ruta
        route = self._find_route(source, destination)
        if not route:
            self.metrics["failed_deliveries"] += 1
            self._log_event(
                NetworkEventType.ERROR,
                source,
                destination,
                {"error": "No route found"}
            )
            return False
        
        # Enviar a través de la ruta
        success = self._send_through_route(packet, route, protocol)
        
        if success:
            self.metrics["successful_deliveries"] += 1
            # Calcular latencia
            route_latency = sum(
                self.routes[route[i]][route[i+1]]["latency"] 
                for i in range(len(route)-1)
            )
            self.metrics["average_latency"] = (
                self.metrics["average_latency"] * (self.metrics["successful_deliveries"] - 1) + 
                route_latency
            ) / self.metrics["successful_deliveries"]
        
        return success
    
    def _find_route(self, source: str, destination: str) -> List[str]:
        """Encuentra una ruta entre nodos (BFS simple)"""
        if source == destination:
            return [source]
        
        visited = set()
        queue = deque([[source]])
        
        while queue:
            path = queue.popleft()
            node = path[-1]
            
            if node == destination:
                return path
            
            if node not in visited:
                visited.add(node)
                for neighbor in self.nodes[node].connections:
                    if neighbor not in visited:
                        new_path = list(path)
                        new_path.append(neighbor)
                        queue.append(new_path)
        
        return None
    
    def _send_through_route(self, packet: Packet, route: List[str], 
                           protocol: Protocol) -> bool:
        """Envía un paquete a través de una ruta"""
        self.metrics["total_packets"] += 1
        
        # Simular envío hop-by-hop
        for i in range(len(route) - 1):
            current_node = route[i]
            next_node = route[i + 1]
            
            # Verificar si el nodo es malicioso
            if self.nodes[next_node].is_malicious and random.random() < 0.3:
                self.metrics["security_breaches"] += 1
                self._log_event(
                    NetworkEventType.SECURITY_BREACH,
                    current_node,
                    next_node,
                    {"action": "packet_intercepted"}
                )
                return False
            
            # Verificar fiabilidad del enlace
            link_info = self.routes[current_node][next_node]
            if random.random() > link_info["reliability"]:
                self.metrics["failed_deliveries"] += 1
                self._log_event(
                    NetworkEventType.ERROR,
                    current_node,
                    next_node,
                    {"error": "Link failure"}
                )
                return False
            
            # Enviar paquete
            packet.source = current_node
            packet.destination = next_node
            protocol.send(packet, self)
            
            # Actualizar contadores de nodos
            self.nodes[current_node].packets_sent += 1
            self.nodes[next_node].packets_received += 1
        
        # Paquete llegó al destino
        packet.destination = route[-1]
        protocol.receive(packet, self)
        
        return True
    
    def _log_event(self, event_type: NetworkEventType, source: str, 
                   destination: str, details: Dict[str, Any]):
        """Registra un evento de red"""
        event = NetworkEvent(
            timestamp=time.time(),
            event_type=event_type,
            source=source,
            destination=destination,
            protocol=ProtocolType.HTTP,  # Por defecto
            details=details
        )
        self.events.append(event)
    
    def compare_protocols(self, source: str, destination: str, 
                         message: str) -> Dict[str, Any]:
        """Compara todos los protocolos enviando el mismo mensaje"""
        results = {}
        
        for protocol_type in self.protocols:
            start_time = time.time()
            success = self.send_message(source, destination, message, protocol_type)
            end_time = time.time()
            
            protocol = self.protocols[protocol_type]
            metrics = protocol.get_metrics()
            
            results[protocol_type.value] = {
                "success": success,
                "latency": end_time - start_time,
                "packets_sent": metrics["packets_sent"],
                "bytes_transferred": metrics["bytes_transferred"],
                "errors": metrics["errors"],
                "retransmissions": metrics.get("retransmissions", 0),
                "security_level": protocol.security_level.value,
                "info": protocol.get_protocol_info()
            }
        
        return results
    
    def visualize_network(self) -> str:
        """Visualización ASCII de la red"""
        lines = []
        
        lines.append("🌐 NETWORK QUEST - Estado de la Red")
        lines.append("=" * 70)
        
        # Nodos
        lines.append("\n📡 NODOS:")
        for node_id, node in self.nodes.items():
            status = "🔴" if node.is_malicious else "🟢"
            lines.append(f"  {status} {node_id:10} ({node.node_type:10}) "
                       f"IP: {node.ip_address:15} "
                       f"BW: {node.bandwidth:3d}Mbps "
                       f"Conn: {len(node.connections):2d}")
        
        # Conexiones
        lines.append("\n🔗 CONEXIONES:")
        for node1_id in self.routes:
            for node2_id in self.routes[node1_id]:
                if node1_id < node2_id:  # Mostrar solo una vez
                    info = self.routes[node1_id][node2_id]
                    lines.append(f"  {node1_id:10} ↔ {node2_id:10} "
                               f"Lat: {info['latency']:5.1f}ms "
                               f"BW: {info['bandwidth']:3d}Mbps "
                               f"Rel: {info['reliability']*100:3.0f}%")
        
        # Protocolos
        lines.append("\n📊 PROTOCOLOS DISPONIBLES:")
        for protocol_type, protocol in self.protocols.items():
            metrics = protocol.get_metrics()
            lines.append(f"  • {protocol_type.value:20} "
                       f"Packets: {metrics['packets_sent']:4d} "
                       f"Security: {protocol.security_level.value}")
        
        # Métricas
        lines.append(f"\n📈 MÉTRICAS GLOBALES:")
        lines.append(f"  • Paquetes totales: {self.metrics['total_packets']}")
        lines.append(f"  • Entregas exitosas: {self.metrics['successful_deliveries']}")
        lines.append(f"  • Latencia promedio: {self.metrics['average_latency']:.2f}ms")
        lines.append(f"  • Brechas de seguridad: {self.metrics['security_breaches']}")
        
        lines.append("=" * 70)
        return "\n".join(lines)

