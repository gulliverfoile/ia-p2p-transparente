class Protocol:
    """Clase base para todos los protocolos"""
    
    def __init__(self, protocol_type: ProtocolType, security_level: SecurityLevel):
        self.protocol_type = protocol_type
        self.security_level = security_level
        self.packet_counter = 0
        self.events = []
        self.metrics = {
            "packets_sent": 0,
            "packets_received": 0,
            "bytes_transferred": 0,
            "errors": 0,
            "retransmissions": 0,
            "latency_avg": 0.0,
            "throughput": 0.0
        }
    
    def create_packet(self, source: str, destination: str, 
                     packet_type: PacketType, payload: Any) -> Packet:
        """Crea un nuevo paquete"""
        self.packet_counter += 1
        packet = Packet(
            packet_id=self.packet_counter,
            source=source,
            destination=destination,
            packet_type=packet_type,
            payload=payload,
            protocol=self.protocol_type,
            ttl=64
        )
        
        if self.security_level != SecurityLevel.NONE:
            packet.encrypted = True
        
        packet.checksum = packet.calculate_checksum()
        return packet
    
    def send(self, packet: Packet, network: 'Network') -> bool:
        """Envía un paquete (método base)"""
        self.metrics["packets_sent"] += 1
        self.metrics["bytes_transferred"] += len(str(packet.payload))
        
        self._log_event(
            NetworkEventType.PACKET_SENT,
            packet.source,
            packet.destination,
            {"packet": packet.to_dict()}
        )
        
        return True
    
    def receive(self, packet: Packet, network: 'Network') -> bool:
        """Recibe un paquete (método base)"""
        self.metrics["packets_received"] += 1
        
        self._log_event(
            NetworkEventType.PACKET_RECEIVED,
            packet.source,
            packet.destination,
            {"packet": packet.to_dict()}
        )
        
        return True
    
    def _log_event(self, event_type: NetworkEventType, source: str, 
                   destination: str, details: Dict[str, Any]):
        """Registra un evento"""
        event = NetworkEvent(
            timestamp=time.time(),
            event_type=event_type,
            source=source,
            destination=destination,
            protocol=self.protocol_type,
            details=details
        )
        self.events.append(event)
    
    def get_metrics(self) -> Dict[str, Any]:
        """Obtiene métricas del protocolo"""
        return self.metrics.copy()
    
    def get_protocol_info(self) -> Dict[str, Any]:
        """Información educativa del protocolo"""
        return {
            "name": self.protocol_type.value,
            "security": self.security_level.value,
            "description": "",
            "advantages": [],
            "disadvantages": [],
            "use_cases": []
        }

class ProtocolFactory:
    """Fábrica de protocolos"""
    
    @staticmethod
    def create_protocol(protocol_type: ProtocolType, 
                       security_level: SecurityLevel = SecurityLevel.NONE) -> Protocol:
        """Crea una instancia del protocolo especificado"""
        if protocol_type == ProtocolType.HTTP:
            return HTTPProtocol(security_level)
        elif protocol_type == ProtocolType.TCP:
            return TCPProtocol(security_level)
        elif protocol_type == ProtocolType.ONION:
            return OnionProtocol(security_level)
        elif protocol_type == ProtocolType.QUIC:
            return QUICProtocol(security_level)
        elif protocol_type == ProtocolType.BITCOIN:
            return BitcoinProtocol(security_level)
        elif protocol_type == ProtocolType.UDP:
            return UDPProtocol(security_level)
        else:
            raise ValueError(f"Protocolo no soportado: {protocol_type}")

