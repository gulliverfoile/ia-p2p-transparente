    def __init__(self):
        # Importar Kernel existente (asumiendo que está en el mismo archivo)
        from kernel_module import Kernel  # Esto es simbólico
        
        self.kernel = Kernel()  # Kernel de procesos
        self.network = NetworkSimulator()  # Módulo de red
        self.network_processes = {}  # Procesos que usan red
        
        # Crear algunos nodos de red asociados a procesos
        self._setup_network_integration()
    
    def _setup_network_integration(self):
        """Configura la integración entre kernel y red"""
        # Crear nodos de red para procesos importantes
        self.network.add_node("kernel", "server", bandwidth=1000, latency=1)
        
        # Escuchar eventos de red y crear procesos correspondientes
        # (esto es solo un ejemplo de cómo podrían integrarse)
    
    def create_network_process(self, process_name: str, protocol: ProtocolType):
        """Crea un proceso que usa la red"""
        # Crear proceso en el kernel
        process = self.kernel.create_process(
            name=f"Net_{process_name}",
            burst_time=random.randint(10, 30),
            memory=random.randint(20, 100)
        )
        
        if process:
            # Crear nodo de red para este proceso
            node_id = f"proc_{process.pid}"
            self.network.add_node(
                node_id,
                "client",
                bandwidth=random.randint(10, 100),
                latency=random.uniform(5, 50)
            )
            
            # Conectar al kernel
            self.network.connect_nodes(node_id, "kernel")
            
            # Guardar referencia
            self.network_processes[process.pid] = {
                "process": process,
                "node_id": node_id,
                "protocol": protocol
            }
            
            return process
        
        return None
    
    def simulate_network_activity(self):
        """Simula actividad de red para todos los procesos"""
        for pid, info in self.network_processes.items():
            process = info["process"]
            if process.state != ProcessState.TERMINATED:
                # Enviar mensaje aleatorio
                message = f"Mensaje de {process.name}"
                success = self.network.send_message(
                    info["node_id"],
                    "kernel",
                    message,
                    info["protocol"]
                )
                
                if success:
                    print(f"📤 {process.name} envió mensaje via {info['protocol'].value}")
                else:
                    print(f"❌ {process.name} falló al enviar mensaje")

