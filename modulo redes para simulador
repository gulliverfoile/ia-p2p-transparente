                "Migración de conexión"
            ]
        })
        return info

class BitcoinProtocol(Protocol):
    """Protocolo P2P de Bitcoin simplificado"""
    
    def __init__(self, security_level: SecurityLevel):
        super().__init__(ProtocolType.BITCOIN, SecurityLevel.STRONG)
        self.peers = set()
        self.blockchain = []
        self.mempool = []  # Transacciones no confirmadas
        self.difficulty = 4  # Número de ceros iniciales en hash
    
    def send(self, packet: Packet, network: 'Network') -> bool:
        """Envía un mensaje de la red Bitcoin"""
        message_type = packet.packet_type
        
        if message_type == PacketType.DATA:
            # Simular transacción
            transaction = {
                "txid": hashlib.sha256(str(packet.payload).encode()).hexdigest()[:16],
                "from": packet.source,
                "to": packet.destination,
                "amount": random.randint(1, 100),
                "fee": random.random()
            }
            packet.payload = f"TX:{json.dumps(transaction)}"
            self.mempool.append(transaction)
        
        elif message_type == PacketType.ROUTING:
            # Gossip de red P2P
            packet.payload = f"PEER_LIST:{','.join(list(self.peers)[:5])}"
        
        # Bitcoin usa flood (inundación) - reenviar a múltiples peers
        if packet.source != "broadcast":
            for peer in list(self.peers)[:3]:  # Enviar a 3 peers aleatorios
                if peer != packet.source:
                    network.send_packet(packet.source, peer, packet.payload, self.protocol_type)
        
        return super().send(packet, network)
    
    def mine_block(self, miner: str) -> Dict[str, Any]:
        """Simula minería de un bloque"""
        nonce = 0
        transactions = self.mempool[:10]  # Tomar primeras 10 transacciones
        
        while True:
            block_data = {
                "prev_hash": self.blockchain[-1]["hash"] if self.blockchain else "0"*64,
                "transactions": transactions,
                "nonce": nonce,
                "miner": miner
            }
            
            block_hash = hashlib.sha256(json.dumps(block_data).encode()).hexdigest()
            
            if block_hash.startswith("0" * self.difficulty):
                block = {
                    **block_data,
                    "hash": block_hash,
                    "timestamp": time.time()
                }
                self.blockchain.append(block)
                self.mempool = self.mempool[10:]  # Remover transacciones minadas
                return block
            
            nonce += 1
            if nonce > 1000:  # Límite para demo
                break
        
        return None
    
    def get_protocol_info(self) -> Dict[str, Any]:
        info = super().get_protocol_info()
        info.update({
            "description": "Protocolo P2P de Bitcoin. Red descentralizada para transferencia de valor usando tecnología blockchain.",
            "advantages": [
                "Completamente descentralizado",
                "Resistente a censura",
                "Transacciones irreversibles",
                "Sin necesidad de confianza"
            ],
            "disadvantages": [
                "Alto consumo energético (PoW)",
                "Baja escalabilidad (~7 TPS)",
