class OnionProtocol(Protocol):
    """Protocolo Onion Routing (simplificado tipo Tor)"""
    
    def __init__(self, security_level: SecurityLevel):
        super().__init__(ProtocolType.ONION, SecurityLevel.ONION)
        self.relay_nodes = []
        self.circuits = {}  # circuit_id -> [relay1, relay2, relay3]
    
    def create_onion_packet(self, source: str, destination: str, 
                           payload: Any, num_layers: int = 3) -> Packet:
        """Crea un paquete con cifrado por capas (como una cebolla)"""
        packet = self.create_packet(source, destination, PacketType.ONION_LAYER, payload)
        
        # Crear capas de cifrado
        layers = []
        current_payload = payload
        
        for i in range(num_layers):
            layer = {
                "layer": i,
                "next_hop": f"relay_{i}",
                "encrypted_payload": self._encrypt_layer(current_payload, i),
                "routing_info": f"Dest: {destination if i == 0 else f'relay_{i-1}'}"
            }
            layers.insert(0, layer)  # Insertar al principio (capa más externa primero)
            current_payload = json.dumps(layer)
        
        packet.layers = layers
        packet.payload = current_payload  # Payload final (la cebolla completa)
        
        return packet
    
    def _encrypt_layer(self, data: Any, layer_num: int) -> str:
        """Simula cifrado de una capa"""
        data_str = str(data)
        # "Cifrado" simple (en realidad, solo codificación)
        encoded = base64.b64encode(data_str.encode()).decode()
        return f"ENCRYPTED_LAYER_{layer_num}:{encoded}"
    
    def _decrypt_layer(self, encrypted: str, layer_num: int) -> str:
        """Simula descifrado de una capa"""
        if encrypted.startswith(f"ENCRYPTED_LAYER_{layer_num}:"):
            encoded = encrypted.split(":", 1)[1]
            return base64.b64decode(encoded).decode()
        return encrypted
    
    def process_onion_packet(self, packet: Packet, current_node: str) -> Optional[Packet]:
        """Procesa un paquete onion (descifra una capa)"""
        if not packet.layers:
            return None
        
        # Descifrar la capa correspondiente
        for i, layer in enumerate(packet.layers):
            if layer["next_hop"] == current_node:
                decrypted = self._decrypt_layer(layer["encrypted_payload"], i)
                
                # Crear nuevo paquete para el próximo salto
                new_packet = Packet(
                    packet_id=packet.packet_id,
                    source=packet.source,
                    destination=layer["routing_info"].split(": ")[1],
                    packet_type=packet.packet_type,
                    payload=decrypted,
                    protocol=self.protocol_type,
                    layers=packet.layers[i+1:] if i+1 < len(packet.layers) else []
                )
                
                self._log_event(
                    NetworkEventType.PACKET_RECEIVED,
                    current_node,
                    new_packet.destination,
                    {"action": "onion_layer_peeled", "remaining_layers": len(new_packet.layers)}
                )
                
                return new_packet
        
        return None
    
    def get_protocol_info(self) -> Dict[str, Any]:
        info = super().get_protocol_info()
        info.update({
            "description": "Onion Routing (ejemplo: Tor). Técnica de anonimización que encapsula mensajes en capas de cifrado, como una cebolla.",
            "advantages": [
                "Alto anonimato y privacidad",
                "Resistente a análisis de tráfico",
                "Descentralizado",
                "Cifrado punto-a-punto"
            ],
            "disadvantages": [
                "Alta latencia (múltiples saltos)",
                "Ancho de banda limitado",
                "Complejidad de configuración",
                "Posibles nodos maliciosos (exit nodes)"
            ],
            "use_cases": [
                "Navegación anónima (Tor Browser)",
                "Comunicaciones confidenciales",
                "Evitar censura gubernamental",
                "Periodismo de investigación"
            ],
            "how_it_works": [
                "1. Cliente establece circuito con múltiples relays",
                "2. Datos se cifran en capas (una por relay)",
                "3. Cada relay descifra una capa y reenvía",
                "4. Relay final envía datos al destino",
                "5. Respuesta sigue ruta inversa"
            ]
        })
        return info

class QUICProtocol(Protocol):
    """Protocolo QUIC (HTTP/3) simplificado"""
    
    def __init__(self, security_level: SecurityLevel):
        super().__init__(ProtocolType.QUIC, SecurityLevel.STRONG)
        self.streams = {}
        self.multiplexing = True
    
    def send(self, packet: Packet, network: 'Network') -> bool:
        """Envía un paquete QUIC"""
        # QUIC incluye cifrado por defecto
        packet.encrypted = True
        
        # Simular multiplexación de streams
        if self.multiplexing:
            stream_id = random.randint(1, 100)
            packet.payload = f"STREAM:{stream_id}:{packet.payload}"
        
        # QUIC usa UDP pero con confiabilidad
        if random.random() < 0.05:  # 5% de pérdida (menor que UDP puro)
            # Retransmisión rápida
            self.metrics["retransmissions"] += 1
            network.schedule_event(
                time.time() + 0.05,  # Retransmisión rápida
                lambda: super().send(packet, network)
            )
            return False
        
        return super().send(packet, network)
    
    def get_protocol_info(self) -> Dict[str, Any]:
        info = super().get_protocol_info()
        info.update({
            "description": "QUIC (Quick UDP Internet Connections). Protocolo de transporte sobre UDP desarrollado por Google, base de HTTP/3.",
            "advantages": [
                "Establecimiento de conexión rápido (0-RTT)",
                "Multiplexación sin head-of-line blocking",
